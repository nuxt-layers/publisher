{
  "name": "@nuxt-layers/publisher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless Nuxt 4 foundation layer for publishing documents of types the host registers: drafts, versions, approval, moderation, scheduling, addresses, safe rich text, listings and feeds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nuxt-layers/publisher"
  },
  "exports": {
    ".": "./nuxt.config.ts",
    "./contracts": "./shared/contracts.ts",
    "./examples": "./examples/index.ts",
    "./testing": "./testing/index.ts"
  },
  "files": [
    "app",
    "examples",
    "server",
    "shared",
    "testing",
    "nuxt.config.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev:prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "build:playground": "nuxt build playground",
    "dev": "nuxt dev playground"
  },
  "dependencies": {
    "@nuxt-layers/rich-text": "github:nuxt-layers/rich-text#master",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "nuxt": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "h3": "^1.15.11",
    "nuxt": "^4.6.3",
    "pg": "^8.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  }
}
